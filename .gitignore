# ESP-IDF build artifacts and generated config (patterns without a slash match at every level)
build/
build_burn/
managed_components/
sdkconfig
sdkconfig.old
sdkconfig.flasher
# sdkconfig.defaults, sdkconfig.burn, and dependencies.lock stay tracked

# Flasher GUI build outputs (merged firmware + build-info sidecars)
flasher/builds/*.bin
flasher/builds/*.json
!flasher/builds/.gitkeep

# graphify knowledge-graph output (regenerate with: graphify update .)
graphify-out/

# Machine-local assistant settings and caches (.agents/ and .cursor/ stay tracked)
.claude/
.codex/
.gemini/

# Secrets and offline Secure Boot signing keys (ADR 0015) must never be committed
.env
.env.*
*.pem

# Python, tooling, OS, and editor artifacts
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.code-workspace
