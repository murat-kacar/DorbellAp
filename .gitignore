# ESP-IDF build artifacts and generated config (patterns without a slash match at every level)
build/
managed_components/
sdkconfig
sdkconfig.old
# sdkconfig.defaults and dependencies.lock stay tracked (not matched by the rules above)

# Flasher GUI build outputs (merged firmware + build-info sidecars)
flasher/builds/*.bin
flasher/builds/*.json
!flasher/builds/.gitkeep

# graphify knowledge-graph output (regenerate with: graphify update .)
graphify-out/

# Machine-local assistant settings (graphify hooks use an absolute graphify.exe path)
.claude/settings.local.json
.codex/
.gemini/settings.json

# Secrets (API keys, Wi-Fi credentials) must never be committed
.env
.env.*

# OS, Python & editor files
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Secure Boot signing keys are kept offline by the owner (ADR 0015) and must never be committed
*.pem
