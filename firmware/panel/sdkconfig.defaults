# DorbellAp Building Entrance Panel Default Configuration
CONFIG_DOORBELL_ROLE_PANEL=y

# Flash Configuration (2 MB, single factory partition, no OTA — ADR 0013)
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# CPU & Watchdog Safety (I-46, I-70)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

# Storage & Wi-Fi Security (I-4, I-13, I-23, I-70)
CONFIG_NVS_FLASH_VERIFY_ERASE=y
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=y

# lwIP Fast DHCP Recovery & ARP Check (I-38, I-70)
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y

