# DorbellAp Apartment Module (Indoor Unit) - only the deviations from the ESP-IDF v6.1 defaults (AGENTS.md I-70).
#
# Relied-upon ESP-IDF defaults (not repeated here; do not change in menuconfig): 2 MB flash, single factory app
# partition (no OTA, ADR 0013), 160 MHz CPU, brownout detector, interrupt WDT 300 ms, task WDT enabled with a 5 s
# timeout, DHCP ARP check of the offered address.
CONFIG_DOORBELL_ROLE_UNIT=y

# Release build (-Os), same as the panel
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Restart on a hung task instead of only logging it (I-46)
CONFIG_ESP_TASK_WDT_PANIC=y

# Storage reliability (I-13); building Wi-Fi credentials never stored by the Wi-Fi driver (I-23)
CONFIG_NVS_FLASH_VERIFY_ERASE=y
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Faster IP recovery after a reboot (I-38)
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
