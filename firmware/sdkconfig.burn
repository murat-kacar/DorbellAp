# DorbellAp Burn profile overlay (ADR 0015, Option B) - applied by the flasher on top of the role's sdkconfig
# in a separate build directory (build_burn/). Development and Production builds never read this file.
# Every line is authoritative: the flasher replaces the matching CONFIG_ line (set or "is not set") and kconfgen
# resolves the dependencies. The flasher checks the resolved values after the build.

# Secure Boot v2 (RSA-3072) needs ESP32 chip revision v3.0 or newer (secure-boot-v2.rst)
CONFIG_ESP32_REV_MIN_3=y
# CONFIG_ESP32_REV_MIN_0 is not set
# CONFIG_ESP32_REV_MIN_1 is not set
# CONFIG_ESP32_REV_MIN_1_1 is not set
# CONFIG_ESP32_REV_MIN_2 is not set
# CONFIG_ESP32_REV_MIN_3_1 is not set

# Secure Boot v2; the flasher signs the images itself (espsecure sign-data) with a one-time key created for the build
# and destroyed afterwards, so no key path enters sdkconfig or the build tree
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
# CONFIG_SECURE_BOOT_V1_ENABLED is not set
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set

# Flash encryption, release mode: the bootloader generates the key on the chip at first boot
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT is not set

# UART ROM download mode permanently disabled (IDF recommendation for production; ESP32 has no secure download mode)
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
# CONFIG_SECURE_INSECURE_ALLOW_DL_MODE is not set

# NVS encryption, keys in the flash-encrypted nvs_keys partition (ESP32 has no HMAC peripheral)
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y

# Custom partition table with nvs_keys; offset moved for the larger secure bootloader
CONFIG_PARTITION_TABLE_CUSTOM=y
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
# CONFIG_PARTITION_TABLE_TWO_OTA is not set
# CONFIG_PARTITION_TABLE_TWO_OTA_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions_burn.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
